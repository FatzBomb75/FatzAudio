<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ApplicationId>net.fatzaudio.ciapp</ApplicationId>
    <CodesignKey>-</CodesignKey>
    <!-- Where tools/build-xcframework.sh put the framework (BUILD_DIR/fatzaudio.xcframework). -->
    <FatzAudioXcframework Condition="'$(FatzAudioXcframework)' == ''">$(MSBuildThisFileDirectory)../../../build-ios/fatzaudio.xcframework</FatzAudioXcframework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../bindings/dotnet/src/FatzAudio/FatzAudio.csproj" />
    <Compile Include="../shared/AppCheck.cs" />
    <NativeReference Include="$(FatzAudioXcframework)">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>

</Project>
